# KVMPHONE 环境变量示例。都不是必填；需要时 export 到 shell 或写进 LaunchAgent 的 EnvironmentVariables。
# 密钥一律放 600 文件，由配置里的 *_file 路径指向，不写进这里。

# ---- kp（点屏读屏）----
KP_DEV=rmq1                  # 选哪台手机（devices.json 里的键），默认 rmq1
KP_OWNER=claude              # 租约身份：同一台手机同一时刻只归一个调用方（rmq 任务自动设 rmq:<id>，OpenClaw 设 openclaw）
KP_LOCAL=0                   # 1 = 不经 ssh 转发，在本机起桥（调试用）
KP_DEVICES=                  # 设备表路径，默认 kvmphone/devices.json
KP_BASE=                     # 直接指定桥地址，如 http://127.0.0.1:7690（接别的采集后端时用）
KP_PACE=on                   # off = 关掉风控 App 的拟人放慢
KP_DEBUG=0                   # 1 = 打印每段耗时
KP_LEARNED=~/.config/kvmphone/learned   # 驾驶模型「学到」的 App 事实写到这里
JEVJUDGE_URL=                # 可选的判屏服务，默认依次试 http://127.0.0.1:7677 和 :7681；2 秒没回就跳过
WDA_URL=http://127.0.0.1:8100  # 只有 WebDriverAgent 后端用得到

# ---- rmq（任务队列）----
RMQ_HOME=~/.rmq              # 队列、任务目录、config.json 所在

# ---- subgate（CLIProxyAPI，给飞书机器人用）----
MINI=macmini                 # 执行机的 ssh 别名
MINI_LAN_HOST=your-mini.local  # OpenClaw 访问执行机 subgate 用的局域网主机名
CLIPROXY_BIN=~/.local/opt/cliproxyapi/cli-proxy-api
